{
  "redirects": [
    {
      "source": "/((?!api/.*).*)",
      "has": [
        {
          "type": "host",
          "value": "pyjama-dz.vercel.app"
        }
      ],
      "destination": "https://www.pyjama-dz.net/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/((?!assets/.*|.*\\.(?:webp|png|jpg|jpeg|svg|ico|woff2)).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0, s-maxage=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:webp|png|jpg|jpeg|svg|ico|woff2))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron-notifications?action=weekly_hot_sale",
      "schedule": "0 10 * * 5"
    },
    {
      "path": "/api/cron-notifications?action=process_delayed_confirmations",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/check-low-stock",
      "schedule": "0 10 * * *"
    }
  ]
}
